# --- AgentField ---
AGENT_NODE_ID=spider-agent
AGENTFIELD_SERVER=http://control-plane:8080
PORT=8005
AGENT_CALLBACK_URL=http://spider-agent:8005

# Optional LLM config (unused by v1 — kept for parity with fleet)
AI_MODEL=openrouter/google/gemini-2.5-flash
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- HTTP surface (rag-stack-compatible) ---
CRAWLER_PORT=11700

# Agent -> HTTP bridge. compose default reaches the sibling service;
# k3s sidecar uses localhost (the ConfigMap overrides).
SPIDER_HTTP_URL=http://spider-http:11700
SPIDER_TIMEOUT_S=60

# --- Redis (queue, seen-set, feeds, jobs) ---
REDIS_URL=redis://redis:6379/0

# --- Crawl politeness ---
CRAWL_HOST_RPS=1.0
CRAWL_HOST_BURST=1
CRAWL_ROBOTS_TTL_S=3600
CRAWL_ROBOTS_UA=agentfield-spider/0.1
CRAWL_ROBOTS_DISABLE=0
CRAWL_CONCURRENCY=3

# --- Browser pool ---
BROWSER_MAX_PAGES=3
BROWSER_IDLE_S=60
FETCH_TIMEOUT_MS=30000
FETCH_HEADLESS=1
FETCH_DISABLE_RES=1
FETCH_NETWORK_IDLE=1

# Pick the default browser backend: "cloak" (CloakBrowser, default,
# stealth Chromium) or "lightpanda" (BETA, Zig CDP browser, much
# lighter but partial coverage). Per-call override on /fetch/sync via
# the `browser` field on the payload.
BROWSER_BACKEND=cloak

# --- CloakBrowser v0.6.5+ stealth & behavioral knobs (optional) ---
# CLOAK_HUMANIZE=1 enables Bézier mouse curves, per-character typing,
# and realistic scroll patterns across all page interactions.
CLOAK_HUMANIZE=0
# Preset when CLOAK_HUMANIZE=1: "default" or "careful".
CLOAK_HUMAN_PRESET=
# CLOAK_GEOIP=1 auto-detects timezone & locale from the proxy exit IP
# and spoofs WebRTC ICE candidates (--fingerprint-webrtc-ip=<exit_ip>).
# Requires the [geoip] extra (`pip install 'cloakbrowser[geoip]'`).
CLOAK_GEOIP=0
# Explicit IANA timezone / BCP-47 locale overrides (optional):
CLOAK_TIMEZONE=
CLOAK_LOCALE=
# Optional CloakBrowser Pro license key (fetches Chromium 155+ Pro Stable):
CLOAKBROWSER_LICENSE_KEY=

# --- Lightpanda backend (beta) ---
# URL of the Lightpanda CDP server. Default works when running it
# alongside spider-agent in the same docker-compose network
# (see Dockerfile.lightpanda + docker-compose.yml).
# Start with: `docker compose --profile lightpanda up`.
LIGHTPANDA_CDP_URL=http://lightpanda:9222
LIGHTPANDA_CONNECT_TIMEOUT_MS=30000

# --- Docling (PDF / Word / PowerPoint structured parse) ---
# Docling is opt-in via the [docling] extra in pyproject.toml. It
# pulls in transformers + torch, adds ~1.5 GB of ML models on first
# use. Not installed in the default Dockerfile; build with
# `--build-arg INSTALL_DOCLING=1` (see Dockerfile) to enable.
# Setup scripts accept both vars for compatibility; prefer
# SPIDER_INSTALL_DOCLING going forward.
SPIDER_INSTALL_DOCLING=0
SPIDER_DOCLING_ENABLED=0
# Runtime parser tuning:
SPIDER_DOCLING_TIMEOUT_S=120
SPIDER_DOCLING_MAX_TABLES=10
SPIDER_DOCLING_TABLES_PREVIEW=3
SPIDER_DOCLING_MAX_TEXT_CHARS=500000

# --- Docker / registry bootstrap (for .environment/setup.sh) ---
# When SPIDER_INSTALL_DOCKER=1 (default), setup.sh installs Docker CLI
# and buildx plugin, then logs in if DOCKER_USER + DOCKER_PAT are set.
SPIDER_INSTALL_DOCKER=1
# If strict mode is enabled, setup fails when Docker install/login is
# requested but cannot be completed (e.g., no root/sudo access).
SPIDER_INSTALL_DOCKER_STRICT=0
DOCKER_REGISTRY=docker.io
DOCKER_USER=
DOCKER_PAT=

# --- Session / context management ---
# Maximum number of named browser sessions kept in memory. On overflow
# the least-recently-used session is closed (LRU eviction).
SPIDER_MAX_SESSIONS=100
# Per-session TTL (seconds). A session untouched for longer than this
# is closed on next access. Set 0 to disable expiry (rely only on
# LRU eviction at the hard cap).
SPIDER_SESSION_TTL_S=7200

# --- URL-kind dispatcher ---
# Optional. Sent as Bearer auth on GitHub REST API calls to lift rate
# limits (5000/hr authenticated vs 60/hr unauthenticated). The fetcher
# falls through to unauthenticated if unset.
GITHUB_TOKEN=

# --- Outbound proxy (optional) ---
# When set, ALL outbound HTTP egresses through this proxy:
#   - specialized HTTP fetchers (github / hn / reddit)
#   - the redirect walker + robots.txt fetcher
#   - the CloakBrowser pool (Chromium launched with proxy config)
#
# Set this to your 4G/5G phone proxy when crawling sites that
# block datacenter IPs. See docs/phone-as-proxy.md for setup.
#
# Examples:
#   SPIDER_PROXY_URL=socks5://192.168.1.42:1080
#   SPIDER_PROXY_URL=http://user:pass@phone.local:8888
SPIDER_PROXY_URL=

# When set to a truthy value (1, true, yes, on), the spider skips TLS
# certificate verification for outbound HTTPS. Needed when the proxy
# does HTTPS interception (mitmproxy with a UA-spoof addon, Charles,
# Fiddler) and the proxy's CA is not installed in the spider's trust
# store. The proper fix is to install the CA — this flag is the
# documented escape hatch for ephemeral containers / dev iteration.
# See docs/phone-as-proxy.md § "Trusting the proxy's MITM CA".
SPIDER_PROXY_TRUST_INSECURE=

# --- Feed polling ---
FEED_INTERVAL=3600
POLL_TICK_MIN=30
POLL_TICK_MAX=600

# --- Chromadb sink (optional, for auto-indexing fetched pages) ---
SPIDER_SINK_ENABLED=0
SPIDER_SINK_CHROMA_URL=
SPIDER_SINK_COLLECTION=spider_pages
SPIDER_SINK_EMBEDDINGS=sentence-transformers
SPIDER_SINK_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Postgres (optional, for profile persistence) ---
# When set, spider-agent stores browser profiles (cookies + storage
# + user-data zip) and (in a follow-up PR) session storage_state in
# postgres. When unset, profiles are disabled (/profiles returns 503).
# Schema is auto-migrated on startup.
POSTGRES_URL=
# Connection pool sizing. Default min=1, max=5 — generous for an
# agent doing occasional reads + writes.
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=5
POSTGRES_COMMAND_TIMEOUT_S=30

# --- browser-use sidecar + /act ---
# The browser-use/web-ui container exposes CDP on :9222, VNC on :5900,
# and a web UI on :8080. Defaults assume it runs in the same compose
# network under the service name "browser-use". Operators running it
# elsewhere override here.
BROWSER_USE_CDP_URL=http://browser-use:9222
BROWSER_USE_VNC_URL=vnc://browser-use:5900
BROWSER_USE_HTTP_URL=http://browser-use:8080
# Default LLM for browser-use Agent runs (POST /act + spider-agent.act
# skill). LangChain OpenAI client is pointed at OpenRouter, so use any
# OpenRouter-supported model id: openai/gpt-4o, anthropic/claude-3.5-sonnet,
# google/gemini-2.5-flash, etc. OPENROUTER_API_KEY above is the auth.
BROWSER_USE_DEFAULT_MODEL=openai/gpt-4o
# OpenRouter API base URL — almost never overridden. Set this if you
# proxy OpenRouter behind your own gateway.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- /act SSRF allowlist (optional) ---
# When set, the browser-use Agent driving POST /act may only navigate
# to hosts in this list (in addition to the always-on SSRF gate that
# blocks loopback / private / link-local / blocked-hostname targets).
#
# Comma-separated. Entries match the URL host exactly; prefix with a
# dot to match a domain and any subdomain:
#
#   SPIDER_AGENT_ALLOWED_HOSTS=example.com,.docs.python.org,api.github.com
#
# Unset / empty → no allowlist (only the base SSRF gate runs). Callers
# can also pass a per-call ``allowed_hosts`` list in the /act body; the
# two sets are unioned.
SPIDER_AGENT_ALLOWED_HOSTS=

# --- Tracing (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
